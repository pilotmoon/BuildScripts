#!/bin/zsh
# called for pre and post build actions in xcode scheme
set -eu; base=${0:a:h}; source $base/common
memo_vars vars_action
pushd $PROJECT_DIR

action=${1:-none}
metadata_config_path=${BUILDSCRIPTS_METADATA_CONFIG_PATH:-${PROJECT_DIR}/BuildMetadata.generated.xcconfig}
[[ $metadata_config_path = /* ]] || metadata_config_path=$PROJECT_DIR/$metadata_config_path
metadata_swift_path=${BUILDSCRIPTS_METADATA_SWIFT_PATH:-${PROJECT_DIR}/Pop/BuildMetadata.generated.swift}
[[ $metadata_swift_path = /* ]] || metadata_swift_path=$PROJECT_DIR/$metadata_swift_path

# set up log file since there is no log output in xcode
logdir=${PROJECT_DIR}/log; mkdir -p $logdir
logfile=$logdir/$action.log
rm $logfile || true
touch $logfile
exec > $logfile 2>&1
sayhi $0

# write vars to debug
show action metadata_config_path
show BUILDSCRIPTS_VERSION_OFFSET BUILDSCRIPTS_VERSION_DEV

# function writes standardized build metadata xcconfig file
function write_metadata_config() {
mkdir -p "${metadata_config_path:h}"
cat <<END > "$metadata_config_path"
BUILDSCRIPTS_VERSION_NUM = ${1:-0}
BUILDSCRIPTS_VERSION_STRING = ${2:-not_set}
BUILDSCRIPTS_ORIGINAL_VERSION_STRING = ${3:-not_set}
BUILDSCRIPTS_RELEASE_CHANNEL = ${4:-not_set}
BUILDSCRIPTS_RELEASE_EDITION = ${5:-not_set}
END
cat "$metadata_config_path"
}

function remove_metadata_config() {
rm -f "$metadata_config_path"
}

# writes the same build metadata as a swift source compiled into the app.
# embedding the build number in the executable guarantees every build's
# binary content (and hence its mach-o uuid) is unique, so crash reports
# can never be attributed to an earlier build with identical compiled code
# (see builds 6157/6159, aug 2026). outside prebuild the file holds
# placeholder values, so a build that skipped prebuild is obvious.
function write_metadata_swift() {
cat <<END > "$metadata_swift_path"
// Generated by BuildScripts/action; not tracked by git. Do not edit.
// Compiled into the app so every build has a unique binary; placeholder
// values ("0"/"not_set") mean the build ran without the prebuild action.
enum BuildMetadata {
    static let buildNumber = "${1:-0}"
    static let versionString = "${2:-not_set}"
    static let channel = "${3:-not_set}"
    static let edition = "${4:-not_set}"
}
END
cat "$metadata_swift_path"
}

function cleanup_metadata_config_on_exit() {
case $action in
postbuild|postarchive|postarchive_noexport)
  remove_metadata_config
  write_metadata_swift # reset to placeholders
  ;;
esac
}
trap cleanup_metadata_config_on_exit EXIT

# perform action
case $action in
prebuild|prearchive)
source $base/pre/labels $BUILDSCRIPTS_VERSION_OFFSET $BUILDSCRIPTS_VERSION_DEV
write_metadata_config $version_num $version_string $original_version_string $channel $edition
write_metadata_swift $version_num $version_string $channel $edition

# tag repo with build number if Beta or Production
if [[ $channel == $channel_beta || $channel == $channel_production ]]; then
  git tag "b$version_num" || true
fi
;;

postbuild|postarchive_noexport)
# nothing to do; metadata config is cleaned up by the exit trap
;;
postarchive)
display "Exporting archive" "Post-archive script"
$base/post/export # run export script
;;
*) print "unknown action";;
esac

popd
saybye $0
