#!/bin/zsh
set -eu; base=${0:a:h}/..; source $base/common; cd_info

# generate symbol maps from the archive dSYMs and upload them to the files
# api, for server-side symbolication of crash reports. one map per binary
# slice, named symbolMaps/<UUID>.json. re-uploads of an existing name are
# rejected by the server (409): if the existing map carries the same build
# number this is a re-run and we skip, but any other stamp means this
# binary is byte-identical to a different build (nothing compiled changed
# between them), and we fail the build -- crash reports from the new build
# would all be attributed to the old one (see builds 6157/6159, Aug 2026).
#
# usage: symbols [archive_path]
# with no argument, uses the archive vars saved at archive time (the normal
# auto flow). pass an .xcarchive path to backfill maps for an older build.

if [[ $# -ge 1 ]]; then
  adhoc=1
  ARCHIVE_PATH=$1
  ARCHIVE_DSYMS_PATH=$ARCHIVE_PATH/dSYMs
else
  adhoc=''
  # load the archive vars saved at archive time
  memo_vars vars_archive
fi
show ARCHIVE_PATH ARCHIVE_DSYMS_PATH

# app identity for this archive, stamped into the maps so the backend can
# resolve crashed binary UUIDs to real build numbers
appinfo() { /usr/libexec/PlistBuddy -c "Print :ApplicationProperties:$1" $ARCHIVE_PATH/Info.plist }
app_build=$(appinfo CFBundleVersion)
app_version=$(appinfo CFBundleShortVersionString)
bundle_id=$(appinfo CFBundleIdentifier)
show app_build app_version bundle_id

for dwarf in $ARCHIVE_DSYMS_PATH/*.dSYM/Contents/Resources/DWARF/*(N); do
  binary_name=${dwarf:t}
  print "* processing dSYM slices for $binary_name"
  dwarfdump --uuid $dwarf | while read -r _ uuid archpart _; do
    arch=${${archpart#\(}%\)}
    map_name=symbolMaps/$uuid.json
    map_file=map-$uuid.json
    print "* generating $map_name ($arch)"
    $base/bin/make_symbol_map $dwarf $arch $uuid $binary_name \
      $app_build $app_version $bundle_id > $map_file
    [[ -s $map_file ]] || { print "generated map is empty"; exit 1 }
    print "* uploading $map_name ($(du -h $map_file | cut -f1 | tr -d ' '))"
    # note: no --ignore-stdin here; the request body is read from stdin
    set +e
    response=$(http --check-status POST "$PILOTMOON_FILES_API_URL" \
      name=="$map_name" \
      Authorization:"Bearer $PILOTMOON_FILES_API_KEY" \
      < $map_file 2>&1)
    upload_status=$?
    set -e
    if [[ $upload_status -eq 0 ]]; then
      print "uploaded"
    elif [[ $response == *"409"* || $response == *"already exists"* ]]; then
      existing_build=$(http --check-status GET \
        "$PILOTMOON_FILES_API_URL/download/$map_name" \
        Authorization:"Bearer $PILOTMOON_FILES_API_KEY" 2>/dev/null \
        | jq -r '.appBuildVersion // empty' 2>/dev/null) || existing_build=''
      if [[ $existing_build == $app_build ]]; then
        print "already uploaded by build $app_build, skipping"
      else
        print "ERROR: $map_name already exists, stamped for build" \
          "${existing_build:-(unstamped)} -- this binary is identical to" \
          "that build's. Change something compiled into the binary (not" \
          "just resources) and rebuild, or crash reports from build" \
          "$app_build will be misattributed."
        exit 1
      fi
    else
      print "upload failed: $response"
      exit 1
    fi
  done
done

if [[ -z $adhoc ]]; then
  symbols_uploaded=1; save_info symbols_uploaded
fi
